{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "PANEL-REVIZE-PLANI/panel-revize-acceptance-schema.json",
  "title": "Panel Revize Acceptance Criteria Schema",
  "description": "Her fazın kabul kriterlerini ve bunların doğrulama durumunu takip eden şema.",
  "type": "object",
  "required": [
    "project",
    "version",
    "updatedAt",
    "phases"
  ],
  "properties": {
    "project": {
      "type": "string",
      "const": "PANEL-REVIZE"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phaseId",
          "phaseName",
          "criteria"
        ],
        "properties": {
          "phaseId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "phaseName": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]\\.[0-9]+$"
                },
                "description": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "functional",
                    "visual",
                    "data-safety",
                    "performance",
                    "accessibility",
                    "test",
                    "deploy"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not-checked",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "verifiedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "verifiedBy": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "headless-test",
                    "manual-review",
                    "user-confirm",
                    null
                  ]
                },
                "evidenceFile": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
