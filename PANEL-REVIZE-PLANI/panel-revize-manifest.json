    "stateSchema": "PANEL-REVIZE-PLANI/panel-revize-state-schema.json",
    "stateExample": "PANEL-REVIZE-PLANI/panel-revize-state-example.json",
    "tasksFile": "PANEL-REVIZE-PLANI/panel-revize-tasks.json",
    "acceptanceSchema": "PANEL-REVIZE-PLANI/panel-revize-acceptance-schema.json",
    "requiredUpdateFrequency": "every-turn",
    "rules": [
      "Her tur sonunda state.json güncellenir.",
      "currentTaskId her zaman işlenen görevi gösterir.",
      "Tamamlanan her görev completedTasks listesine eklenir.",
      "Bloke görevler blockers dizisinde nedeniyle birlikte kaydedilir.",
      "Sonraki görev nextTaskId olarak belirtilir."
    ]
