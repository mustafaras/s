{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "PANEL-REVIZE-PLANI/panel-revize-state-schema.json",
  "title": "Panel Revize Anti-Amnesia State Schema",
  "description": "PANEL-REVIZE planlamasının anlık durumunu takip eden state dosyasının şeması.",
  "type": "object",
  "required": [
    "project",
    "version",
    "lastUpdated",
    "status",
    "currentTaskId",
    "completedTasks",
    "pendingTasks",
    "blockers",
    "evidence"
  ],
  "properties": {
    "project": {
      "type": "string",
      "const": "PANEL-REVIZE",
      "description": "Proje adı; manifest ile aynı olmalı."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "State format versiyonu."
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 zaman damgası."
    },
    "status": {
      "type": "string",
      "enum": [
        "not-started",
        "in-progress",
        "blocked",
        "completed"
      ],
      "description": "Revizyonun genel durumu."
    },
    "currentTaskId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d+\\.\\d+$",
      "description": "Şu anda işlenen görev ID. Hiçbiri yoksa null."
    },
    "completedTasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$"
      },
      "description": "Tamamlanmış görev ID listesi."
    },
    "pendingTasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$"
      },
      "description": "Başlanmamış veya devam eden görev ID listesi."
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "reason",
          "openedAt"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "description": "Aktif bloke kayıtları."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recordedAt",
          "taskId",
          "kind",
          "summary"
        ],
        "properties": {
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "taskId": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "syntax-check",
              "test-pass",
              "test-fail",
              "manual-review",
              "deploy",
              "note",
              "decision"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Her turun test ve gözlem kayıtları."
    },
    "nextTaskId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d+\\.\\d+$",
      "description": "Bir sonraki önerilen görev."
    },
    "notes": {
      "type": "string",
      "description": "Serbest not alanı."
    }
  }
}
