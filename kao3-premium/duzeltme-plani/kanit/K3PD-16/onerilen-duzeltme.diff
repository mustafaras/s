+  assert.equal(err.t.ui.kaoReaderPlaying, null);
+  assert.equal(err.clips.length, 1, 'hatadan sonra yeni klip denenmez');
+
+  // (c) görünümden çıkış / başka görünüm
+  const exit = playbackHarness();
